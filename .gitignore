# =============================================================================
# Repo-wide ignores for the Java projects portfolio.
#
# Individual projects keep their own .gitignore for anything project-specific;
# this file covers what every project here produces.
# =============================================================================

# --- Build output ------------------------------------------------------------
target/
out/
build/
bin/
dist/

# Compiled and packaged artifacts. All rebuildable from source, and these are
# what pushed this repo's pack past 270 MB, so they stay out of git.
*.class
*.jar
*.war
*.dmg
*.pkg

# ...except the "Java Interview" project, which has no pom.xml and resolves
# JUnit solely from these committed jars. Ignoring them would make that project
# unbuildable on a fresh clone. If it ever gains a build file, drop this.
!Java Interview/lib/*.jar

# --- Node / Angular ----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
**/.angular/cache/
**/coverage/

# --- IntelliJ IDEA -----------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr

# --- JetBrains Junie ----------------------------------------------------------
# Only the agent's scratch state. .junie/guidelines.md is hand-written project
# convention and stays tracked.
**/.junie/memory/

# --- OS junk -----------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Local runtime data ------------------------------------------------------
# H2 file-mode databases (bookmark-api writes ./data/bookmarks.mv.db).
data/
*.mv.db
*.trace.db
